(package(=plakd) & binary(=integration) & test(/^(product_doctor_contract|offline_e2e::leftover_jobs)/))
(package(=plakd) & binary(=integration) & test(/^offline_e2e::real_(process|composition|promoted)_jsonl_quit_/))
