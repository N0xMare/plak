# parallel and durability: one union member per line
package(=plakous-tools)
package(=plakous-tool-process)
package(=plakous-tool-files)
package(=plakous-tool-search)
# Includes the daemon's socket path limit test.
package(=plakous-runner)
package(=plakous-runner-dial)
package(=plakous-host-protocol)
package(=plakous-http)
package(=plakous-cell)
package(=plakous-js-runtime)
package(=plakous-py-worker)
package(=plakous-auth)
package(=plakous-store)
package(=plakous-workspace)
package(=plakous-offline-crash-harness)
package(=plakous-mcp-fake-server)
(package(=plakous-compose) & test(/^(coding_tools|process_projection_evidence|python|javascript)::/))
(package(=plakous-anthropic) & test(/^oauth_model::/))
(package(=plakous) & kind(lib) & test(/^(subscriptions|local_composition|application)::/))
(package(=plakous-hosted) & kind(lib) & test(/^(platform|process_environment|session_log|visual_read|jobs|runtime::resources)::/))
(package(=plakd) & kind(lib) & test(/^(home|signals|store|build_identity|commands::(host_install|subscription_storage|login_host|runner)|terminal_application|terminal_registry|host::(socket|starter|console)|web|gateway|carry|lib_tests|agent_stdio|product_doctor|diagnostics|open_file_limit|storage_space|snapshot_install|sidecars)::/))
(package(=plakd) & binary(=integration) & test(/^(host_install|product_doctor_contract|diagnostics_contract|cli_contract|host_skeleton::(bridge|singleton|reload)|offline_e2e::leftover_jobs|lingering_owner|runner_contract|web_endpoint|telemetry_contract)/))
(package(=plakd) & binary(=integration) & test(=offline_e2e::real_process_cli_sigint_releases_and_resumes_exact_session))
(package(=plakd) & kind(lib) & test(/^oauth_ui::tests::/))
binary(=deploy)

# serial
(package(=plakous-runner) & test(/operator::pty::/))
