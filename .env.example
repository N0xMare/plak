# Copy this file to .env and fill only what you need. `.env` is ignored by Git.
# Plak never auto-loads this file: source it yourself, or set the variables in
# your shell. Never commit, paste, log, or share a real key value.

# --- Provider API keys -------------------------------------------------------
# These four are the only credential variables Plak reads. Each corresponds to
# an API-key account: openai, xai-api, anthropic, openrouter.
#
# Precedence: the process environment wins over the key file written by
# `plak key set`. When the variable is set, the stored file is shadowed and
# `plak key clear` cannot unset it.
#
# Fail-closed: a variable that is set but empty (or larger than 16 KiB, or not
# valid UTF-8) is an error. Plak refuses the account; it does not fall back to
# the file store. Leave the variable unset to use the file store.
#
# OAuth subscription sign-ins are not API keys. They are acquired by
# `plak login` into Plak's own store and must never be put in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# --- Product home ------------------------------------------------------------
# Plak home. Defaults to `$HOME/.plak`. Must be an absolute path; a relative
# value is rejected. Holds `config.toml`, `agents/`, the store and the logs.
PLAK_HOME=

# --- Diagnostics -------------------------------------------------------------
# `tracing` filter directive, for example `info` or `plak=debug,info`. When set
# and non-empty, Plak writes `$PLAK_HOME/logs/plak.log`; when unset, no log file
# is written at all. An unparseable directive is an error, not a fallback.
PLAK_LOG=

# --- Evaluator worker overrides ----------------------------------------------
# Absolute paths to the two evaluator sidecars. By default Plak looks only for a
# sibling of the running `plak` binary; there is no PATH search. Set these to
# point at a binary elsewhere. Each must name an existing regular file, or the
# lookup fails closed. Neither is a credential.
#
# `plakous-js-host`, the JavaScript evaluator used by Code Mode and js-ptc.
PLAK_JS_HOST=
# `monty`, the Python evaluator worker used by py-ptc.
PLAK_MONTY_WORKER=

# Provider base URLs are deliberately not environment variables. A custom route
# requires typed configuration with an explicit origin-bound credential policy.
