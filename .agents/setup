#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd -P)"
started_at="$SECONDS"

step() {
  printf '\n==> %s\n' "$1"
}

install_system_packages() {
  local -a packages=(musl-tools)
  local -a missing=()
  local package
  for package in "${packages[@]}"; do
    dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed || missing+=("$package")
  done
  if ((${#missing[@]} == 0)); then
    echo "System packages already installed."
    return
  fi
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

pins="$repo_root/tools/gate/dev-tools.pins"
pinned_target=x86_64-unknown-linux-musl

# Installs the last pins line for a tool on this target (for jj, the newest
# version), unless the destination already reports that version.
install_pinned() {
  local name="$1" destination="$2" line version checksum url installed
  line="$(awk -v tool="$name" -v target="$pinned_target" \
    '$1 == tool && $3 == target { line = $2 " " $4 " " $5 } END { print line }' "$pins")"
  read -r version checksum url <<<"$line"
  if [[ -z "$url" ]]; then
    printf 'error: %s pins no %s for %s\n' "$pins" "$name" "$pinned_target" >&2
    return 1
  fi
  # The version field, without a build suffix such as jj's `-<commit>`.
  installed="$("$destination" --version 2>/dev/null)" || true
  read -r _ installed _ <<<"$installed"
  if [[ "${installed%%-*}" == "$version" ]]; then
    printf '%s %s already installed.\n' "$name" "$version"
    return
  fi

  local archive member temporary
  temporary="$(mktemp -d)"
  archive="$temporary/archive.tar.gz"
  trap 'rm -rf "$temporary"' RETURN
  curl --proto '=https' --tlsv1.2 -fsSL "$url" -o "$archive"
  printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status \
    || { printf 'error: checksum mismatch for %s\n' "$url" >&2; return 1; }
  member="$(tar -tzf "$archive" | awk -v name="$name" '{ n = split($0, part, "/") } !found && part[n] == name { print; found = 1 }')"
  [[ -n "$member" ]] || { printf 'error: no %s in %s\n' "$name" "$url" >&2; return 1; }
  tar -xzf "$archive" -C "$temporary" "$member"
  mkdir -p "$(dirname "$destination")"
  install -m 0755 "$temporary/$member" "$destination"
  rm -rf "$temporary"
  trap - RETURN
  printf 'Installed %s %s.\n' "$name" "$version"
}

step "Install Linux prerequisites"
install_system_packages

step "Install the pinned Rust toolchain"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
fi
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
rustup toolchain install 1.99.0 \
  --profile minimal \
  --component clippy,rustfmt \
  --target x86_64-unknown-linux-musl,wasm32-unknown-unknown

profile_marker="# plak orb tool paths"
if grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  sed -i '/^# plak orb tool paths$/{n;s|^export PATH=.*$|export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"|;}' "$HOME/.bash_profile"
else
  cat >> "$HOME/.bash_profile" <<'EOF'

# plak orb tool paths
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
EOF
fi

step "Install the command runner and jj"
install_pinned just "$HOME/.local/bin/just"
install_pinned jj "$HOME/.local/bin/jj"

step "Install repository-pinned verification tools"
dev_tools="$repo_root/.dev-tools/bin"
install_pinned cargo-nextest "$dev_tools/cargo-nextest"
install_pinned cargo-deny "$dev_tools/cargo-deny"
install_pinned ruff "$dev_tools/ruff"

step "Prefetch locked Rust dependencies"
cd "$repo_root"
cargo fetch --locked
for manifest in tests/fixtures/*/Cargo.toml; do
  cargo fetch --locked --manifest-path "$manifest"
done
mkdir -p target/plak-test-tmp

printf '\nOrb setup completed in %ss.\n' "$((SECONDS - started_at))"
